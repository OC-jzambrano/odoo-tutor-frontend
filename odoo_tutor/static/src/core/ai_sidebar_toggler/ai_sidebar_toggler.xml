<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="ai_chat.AiFloatingButton">
        <t t-if="state.showButton">
            <div
                class="ai-floating-button"
                t-ref="floatingRoot"
                t-att-class="state.dragging ? 'ai-floating-button is-dragging' : 'ai-floating-button'"
                t-att-style="
                    'transform: translate3d(' + state.dragX + 'px, ' + state.dragY + 'px, 0);' +
                    (state.chatOpen ? ' opacity:0; pointer-events:none;' : '')
                "
            >
                <t t-if="state.previewVisible and state.previewMessage and !state.chatOpen">
                    <div class="ai-owl-preview">
                        <button
                            type="button"
                            class="ai-owl-preview-close"
                            t-on-mousedown.stop.prevent="noop"
                            t-on-touchstart.stop.prevent="noop"
                            t-on-click.stop.prevent="closePreview"
                            aria-label="Close preview"
                        >×</button>

                        <div class="ai-owl-preview-time">
                            <t t-esc="previewTimeAgo"/>
                        </div>

                        <div class="ai-owl-preview-text">
                            <t t-esc="state.previewMessage"/>
                        </div>

                        <div class="ai-owl-preview-tail"/>
                    </div>
                </t>

                <button
                    class="ai-owl-trigger"
                    type="button"
                    t-on-mousedown.stop.prevent="onIconDragStart"
                    t-on-touchstart.stop.prevent="onIconDragStart"
                    t-on-click="onIconClick"
                    data-ai-sidebar-toggle="1"
                    aria-controls="offcanvasAiSidebar"
                >
                    <img
                        t-att-src="'/odoo_tutor/static/images/iabotv2.png'"
                        alt="Asistente IA"
                        class="ai-owl-trigger-img"
                    />
                </button>
            </div>
        </t>
    </t>
</templates>
