<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="ai_chat.AiFloatingButton">
        <t t-if="state.showButton">
            <div
                class="ai-floating-button"
                t-ref="floatingRoot"
                t-att-class="{
                    'is-dragging': state.dragging,
                    'is-open': state.chatOpen,
                    'has-preview': state.previewVisible &amp;&amp; state.previewMessage &amp;&amp; !state.chatOpen &amp;&amp; !state.dragging,
                    'has-exercise-cta': launcherExerciseCtaVisible,
                    'has-attention': launcherHasAttention,
                    'is-fresh': isPreviewFresh,
                }"
                t-att-style="
                    'transform: translate3d(' + state.dragX + 'px, ' + state.dragY + 'px, 0);' +
                    (state.chatOpen ? ' opacity:0; pointer-events:none;' : '')
                "
            >
                <t t-if="state.previewVisible and state.previewMessage and !state.chatOpen and !state.dragging">
                    <div class="ai-owl-preview"
                         role="button"
                         tabindex="0"
                         data-ai-tutor-ignore-event="true"
                         t-on-click.stop.prevent="toggleChat"
                         t-on-mouseenter="pausePreview"
                         t-on-mouseleave="resumePreview">
                        <button
                            type="button"
                            class="ai-owl-preview-close"
                            t-on-mousedown.stop.prevent="noop"
                            t-on-touchstart.stop.prevent="noop"
                            t-on-click.stop.prevent="closePreview"
                            t-att-aria-label="translate('Close preview')"
                        >×</button>
                        <div class="ai-owl-preview-time">
                            <t t-esc="previewTimeAgo"/>
                        </div>

                        <div class="ai-owl-preview-text">
                            <t t-foreach="previewSegments" t-as="seg" t-key="seg_index">
                                <t t-if="seg.isCopy">
                                    <span
                                        class="ai-copy-value"
                                        t-att-class="{ 'is-copied': state.previewCopiedText === seg.text }"
                                        role="button"
                                        tabindex="0"
                                        t-att-title="state.previewCopiedText === seg.text ? translate('Copied!') : seg.copyLabel"
                                        t-att-aria-label="seg.copyLabel"
                                        t-on-click="(ev) => this.onCopyPreviewSegment(seg, ev)"
                                        t-on-mousedown.stop.prevent="noop"
                                        t-on-touchstart.stop.prevent="noop"
                                        t-esc="seg.text"
                                    />
                                </t>
                                <t t-else="">
                                    <t t-esc="seg.text"/>
                                </t>
                            </t>
                        </div>

                        <t t-if="launcherExerciseCtaVisible">
                            <div class="ai-owl-exercise-actions"
                                 role="group"
                                 t-att-aria-label="translate('Exercise invitation actions')">
                                <button
                                    type="button"
                                    class="ai-owl-exercise-choice ai-owl-exercise-choice-yes"
                                    t-att-disabled="exerciseCtaBusy"
                                    t-on-mousedown.stop.prevent="noop"
                                    t-on-touchstart.stop.prevent="noop"
                                    t-on-click.stop.prevent="onExerciseCtaStart"
                                >
                                    <t t-if="exerciseCtaBusy" t-esc="translate('Starting...')"/>
                                    <t t-else="" t-esc="translate('Yes')"/>
                                </button>

                                <button
                                    type="button"
                                    class="ai-owl-exercise-choice ai-owl-exercise-choice-cancel"
                                    t-att-disabled="exerciseCtaBusy"
                                    t-on-mousedown.stop.prevent="noop"
                                    t-on-touchstart.stop.prevent="noop"
                                    t-on-click.stop.prevent="onExerciseCtaCancel"
                                >
                                    <t t-esc="translate('Cancel')"/>
                                </button>
                            </div>
                        </t>

                        <div class="ai-owl-preview-tail"/>
                    </div>
                </t>

                <button
                    class="ai-owl-trigger"
                    type="button"
                    t-on-mousedown.stop.prevent="onIconDragStart"
                    t-on-touchstart.stop.prevent="onIconDragStart"
                    t-on-click="onIconClick"
                    data-ai-sidebar-toggle="1"
                    aria-controls="offcanvasAiSidebar"
                    t-att-aria-label="openTutorLabel"
                    t-att-title="openTutorTitle"
                >
                    <span class="ai-owl-trigger-halo"/>
                    <span class="ai-owl-trigger-shell">
                        <span class="ai-owl-trigger-core">
                            <img
                                t-att-src="'/odoo_tutor/static/images/iabotv2.png'"
                                alt="Asistente IA"
                                class="ai-owl-trigger-img"
                            />
                        </span>
                    </span>

                    <span class="ai-owl-trigger-badge">AI</span>
                    <span t-if="!state.optionalStepVisible and state.hintBadgeVisible" class="ai-owl-trigger-hint" title="Nueva pista">
                        <i class="fa fa-lightbulb-o"/>
                    </span>
                </button>
                <button
                    t-if="state.optionalStepVisible"
                    type="button"
                    class="ai-owl-trigger-skip"
                    t-att-disabled="state.optionalStepLoading"
                    t-att-title="translate('Skip optional step')"
                    t-att-aria-label="translate('Skip optional step')"
                    t-on-mousedown.stop.prevent="noop"
                    t-on-touchstart.stop.prevent="noop"
                    t-on-click.stop.prevent="onSkipOptionalStep"
                >
                    <i t-att-class="state.optionalStepLoading ? 'fa fa-spinner fa-spin' : 'fa fa-step-forward'"/>
                </button>
            </div>
        </t>
    </t>
</templates>
