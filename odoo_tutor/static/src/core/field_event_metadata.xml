<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Stable recorder identity sourced from the canonical OWL Field props. -->
    <t t-inherit="web.Field" t-inherit-mode="extension">
        <xpath expr="//div" position="attributes">
            <attribute name="t-att-data-odoo-field">props.name</attribute>
            <attribute name="t-att-data-odoo-field-label">props.fieldInfo?.string || props.record.fields[props.name].string || props.name</attribute>
            <attribute name="t-att-data-odoo-model">props.record.resModel</attribute>
        </xpath>
    </t>
</templates>
