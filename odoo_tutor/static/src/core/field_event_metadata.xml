<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Stable recorder identity sourced from the canonical OWL Field props. -->
    <t t-inherit="web.Field" t-inherit-mode="extension">
        <xpath expr="//div" position="attributes">
            <attribute name="t-att-data-odoo-field">this.props.name</attribute>
            <attribute name="t-att-data-odoo-field-label">this.props.fieldInfo?.string || this.props.record.fields[this.props.name]?.string || this.props.name</attribute>
            <attribute name="t-att-data-odoo-model">this.props.record.resModel</attribute>
        </xpath>
    </t>
</templates>
