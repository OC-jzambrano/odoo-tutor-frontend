<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="ai_chat.AiSidebar">
        <div
            class="offcanvas offcanvas-end d-flex flex-column"
            t-att-class="{
                'is-dark-theme': state.colorScheme === 'dark',
                'is-light-theme': state.colorScheme !== 'dark',
            }"
            tabindex="-1"
            id="offcanvasAiSidebar"
            aria-labelledby="offcanvasAiSidebarLabel"
            t-attf-style="width: {{ state.width }};"
            t-ref="container"
        >
            <div
                class="handle ai-sidebar-handle"
                t-ref="handle"
                t-on-mousedown="onHandleMouseDown"
            />

            <div class="offcanvas-header ai-sidebar-header">
                <div class="ai-sidebar-header-main">
                    <div class="ai-sidebar-brand">
                        <span class="ai-sidebar-brand-mark">
                            <i t-att-class="state.showRecorderPanel ? 'fa fa-dot-circle-o' : 'fa fa-comments-o'"/>
                        </span>

                        <div class="ai-sidebar-brand-copy">
                            <h5 class="offcanvas-title" id="offcanvasExampleLabel">Odoo Tutor</h5>
                            <div class="ai-sidebar-subtitle">
                                <t t-if="state.showRecorderPanel" t-esc="translate('Recorder workspace for guided flows')"/>
                                <t t-else="" t-esc="currentRouteLabel"/>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="ai-sidebar-header-actions">
                    <button
                        t-if="!state.showRecorderPanel"
                        type="button"
                        class="btn rounded-circle p-1 btn-refresh ai-sidebar-reset"
                        t-att-aria-label="translate('Reset')"
                        t-on-click.stop.prevent="reset"
                    >
                        <i class="fa fa-repeat"/>
                    </button>

                    <button
                        t-if="state.canSeeRecorderToggle"
                        type="button"
                        class="btn btn-sm btn-recorder-toggle"
                        t-on-click.stop.prevent="toggleRecorderPanel"
                        t-att-title="state.showRecorderPanel ? translate('Switch to Chat') : translate('Switch to Recorder')"
                    >
                        <i t-att-class="state.showRecorderPanel ? 'fa fa-comments me-1' : 'fa fa-dot-circle-o me-1'"/>
                        <t t-esc="state.showRecorderPanel ? translate('Chat') : translate('Recorder')"/>
                    </button>

                    <div t-if="state.processActive and !state.showRecorderPanel" class="d-flex align-items-center">
                        <button
                            type="button"
                            class="timer-display"
                            t-att-title="translate('Cancel exercise')"
                            t-att-aria-label="translate('Cancel exercise')"
                            t-att-disabled="state.exerciseCancelLoading"
                            t-on-click.stop.prevent="onTimerCancelExercise"
                        >
                            <t t-esc="state.timerValue" t-if="state.timerValue"/>
                            <t t-else="">00:00:00</t>
                            <i t-if="state.exerciseCancelLoading" class="fa fa-spinner fa-spin timer-cancel-icon"/>
                            <i t-else="" class="fa fa-times timer-cancel-icon"/>
                        </button>
                    </div>

                    <button
                        type="button"
                        class="btn-close text-reset"
                        t-att-aria-label="translate('Close')"
                        t-on-click.stop.prevent="onCloseSidebar"
                    />
                </div>
            </div>

            <div class="offcanvas-body ai-sidebar-body flex-grow-1 d-flex flex-column">
                <div class="ai-sidebar-content flex-grow-1 d-flex flex-column h-100">

                    <!-- =========================
                         RECORDER PANEL (SIEMPRE MONTADO, SOLO SE OCULTA)
                         ========================= -->
                    <div t-att-class="state.showRecorderPanel ? 'flex-grow-1 d-flex flex-column h-100' : 'd-none'">
                        <div class="o_ai_recorder_panel" t-att-class="state.recorderStatus === 'recording' ? 'is-recording' : ''">
                            <div class="o_ai_recorder_header">
                                <div class="o_ai_recorder_left">
                                    <span t-if="state.recorderStatus === 'recording'" class="o_ai_rec_badge">
                                        <i class="fa fa-circle"/>
                                        <t t-esc="translate('Recording')"/>
                                    </span>
                                    <span class="o_ai_rec_title" t-esc="translate('Recorder')"/>
                                </div>

                                <div class="o_ai_recorder_right">
                                    <button t-if="state.recorderStatus !== 'recording'"
                                            type="button"
                                            class="btn btn-sm btn-primary"
                                            t-on-click.stop.prevent="onRecorderStart">
                                        <i class="fa fa-play"/> <t t-esc="translate('Start')"/>
                                    </button>

                                    <button t-if="state.recorderStatus === 'recording'"
                                            type="button"
                                            class="btn btn-sm btn-secondary"
                                            t-on-click.stop.prevent="onRecorderPause">
                                        <i class="fa fa-pause"/> <t t-esc="translate('Pause')"/>
                                    </button>

                                    <button t-if="state.recorderStatus !== 'idle'"
                                            type="button"
                                            class="btn btn-sm btn-danger"
                                            t-on-click.stop.prevent="onRecorderFinish">
                                        <i class="fa fa-stop"/> <t t-esc="translate('Finish')"/>
                                    </button>
                                </div>
                            </div>

                            <div class="o_ai_recorder_meta">
                                <div class="o_ai_rec_meta_row">
                                    <span class="lbl" t-esc="translate('Session ID:')"/>
                                    <span class="val" t-esc="state.recorderSessionId || '-'"/>
                                </div>
                                <div class="o_ai_rec_meta_row">
                                    <span class="lbl" t-esc="translate('WebSocket:')"/>
                                    <span class="val" t-esc="wsStatusLabel"/>
                                </div>
                            </div>

                            <div class="o_ai_recorder_controls">
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary"
                                        t-att-disabled="state.recorderStatus === 'idle' or state.recorderPicking"
                                        t-on-click.stop.prevent="onRecorderPick">
                                    <t t-if="state.recorderPicking">
                                        <i class="fa fa-crosshairs fa-spin"/> <t t-esc="translate('Picking...')"/>
                                    </t>
                                    <t t-else="">
                                        <i class="fa fa-crosshairs"/> <t t-esc="translate('Pick element')"/>
                                    </t>
                                </button>

                                <button t-if="state.recorderPicked"
                                        type="button"
                                        class="btn btn-sm btn-outline-secondary"
                                        t-on-click.stop.prevent="onRecorderClearPick">
                                    <i class="fa fa-times"/> <t t-esc="translate('Clear')"/>
                                </button>

                                <div class="o_ai_recorder_pick" t-if="state.recorderPicked">
                                    <i class="fa fa-bullseye"/>
                                    <span t-esc="state.recorderPicked.target_key"/>
                                </div>
                            </div>

                            <div class="o_ai_recorder_step">
                                <textarea class="form-control"
                                          rows="2"
                                          t-model="state.recorderNote"
                                          t-att-placeholder="translate('Step instruction (optional)...')"></textarea>

                                <div class="o_ai_rec_step_actions">
                                    <button type="button"
                                            class="btn btn-sm btn-success"
                                            t-att-disabled="state.recorderStatus === 'idle'"
                                            t-on-click.stop.prevent="onRecorderSaveStep">
                                        <i class="fa fa-save"/> <t t-esc="translate('Save step')"/>
                                    </button>
                                </div>
                            </div>

                            <div class="o_ai_recorder_feed">
                                <div class="o_ai_rec_feed_title" t-esc="translate('Real-time event feed')"/>

                                <div class="o_ai_rec_feed_list">
                                    <t t-foreach="state.recorderFeed" t-as="ev" t-key="ev._id">
                                        <t t-if="ev.event_type === 'STEP_SAVED'">
                                            <div class="o_ai_rec_feed_item">
                                                <div class="line1">
                                                    <span class="typ" t-esc="ev.event_type"/>
                                                    <span class="tgt" t-esc="ev.target"/>
                                                </div>
                                                <div class="line2">
                                                    <span class="ts" t-esc="ev.timestamp"/>
                                                </div>
                                            </div>
                                        </t>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- =========================
                         CHAT PANEL (SIEMPRE MONTADO, SOLO SE OCULTA)
                         ========================= -->
                    <div t-att-class="state.showRecorderPanel ? 'd-none' : 'ai-chat-panel flex-grow-1 d-flex flex-column h-100 position-relative'">
                        <!-- OJO: no self-closing. Mejor siempre tag normal para mount de librerías -->
                        <div t-ref="chat-ui"
                             id="chat-ui-container"
                             t-att-class="{
                                 'h-100': true,
                             }"
                             t-att-aria-busy="state.isLoading ? 'true' : 'false'"></div>

                        <button t-if="showUnreadIndicator"
                                type="button"
                                class="ai-new-message-indicator"
                                t-attf-style="bottom: {{ state.composerHeight + 16 }}px;"
                                t-on-click.stop.prevent="jumpToNewestMessage"
                                t-att-aria-label="unreadIndicatorLabel">
                            <span class="ai-new-message-dot"/>
                            <span class="ai-new-message-label" t-esc="unreadIndicatorLabel"/>
                        </button>

                        <t t-if="state.hintVisible and state.hintMessage">
                            <div class="ai-inline-hint-container"
                                 t-attf-style="bottom: {{ state.composerHeight + 16 }}px;">
                                <div class="ai-inline-hint"
                                     t-key="state.hintCycle"
                                     t-att-class="{
                                         'is-exiting': state.hintExiting,
                                         'is-paused': state.hintHovered,
                                     }"
                                     t-on-mouseenter="pauseInlineHint"
                                     t-on-mouseleave="resumeInlineHint">
                                    <div class="ai-inline-hint-header">
                                        <div class="ai-inline-hint-badge">
                                            <span class="ai-inline-hint-badge-icon">
                                                <i class="fa fa-lightbulb-o"/>
                                            </span>
                                            <span class="ai-inline-hint-badge-text" t-esc="translate('Context hint')"/>
                                        </div>

                                        <div class="ai-inline-hint-time">
                                            <t t-esc="hintTimeAgo"/>
                                        </div>
                                    </div>

                                    <button
                                        type="button"
                                        class="ai-inline-hint-close"
                                        t-on-click.stop.prevent="closeInlineHint"
                                        t-att-aria-label="translate('Close hint')"
                                    >×</button>

                                    <div class="ai-inline-hint-text">
                                        <t t-esc="state.hintMessage"/>
                                    </div>
                                </div>
                            </div>
                        </t>

                        <div class="ai-buttons-container"
                             t-att-class="{'visible': state.showButtons and state.processActive}"
                             t-attf-style="bottom: {{ state.composerHeight + 25 }}px;">

                            <div t-if="state.processActive" class="d-flex align-items-center">
                                <button
                                    class="dk-btn dk-btn-secondary me-2"
                                    t-on-click.stop.prevent="cancelProcess">
                                    <t t-esc="translate('Cancel')"/>
                                </button>

                                <button class="dk-btn dk-btn-accent"
                                        t-on-click.stop.prevent="showResultModal"
                                        t-att-disabled="state.finishLoading">
                                    <t t-if="state.finishLoading">
                                        <i class="fa fa-spinner fa-spin mr-2"/>
                                    </t>
                                    <t t-else="" t-esc="translate('Finish')"/>
                                </button>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </t>
</templates>
