<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_odoo_tutor" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.chatbot</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Odoo Tutor" name="odoo_tutor">
                    <block title="Tutor Service" name="odoo_tutor_chatbot_settings">
                        <setting string="Installation ID" help="Generated by Odoo and used as the stable identity for this database.">
                            <field name="chatbot_installation_id" groups="base.group_system" />
                        </setting>
                        <setting string="Activation status" help="Informational status returned by the activation workflow.">
                            <field name="chatbot_activation_status" readonly="1" groups="base.group_system" />
                        </setting>
                        <setting string="WebSocket URL" help="WebSocket address of the tutor service for interactive sessions.">
                            <field
                                name="chatbot_ws_base_url"
                                groups="base.group_system"
                                placeholder="wss://tutor-backend.iapps.bond/ws"
                            />
                        </setting>
                        <setting string="Tutor Service API Key" help="Server-side API credential used for authenticated service requests. It is never returned to browser code.">
                            <field name="chatbot_api_key" password="True" groups="base.group_system" />
                        </setting>
                        <setting string="Activation code" help="Required initial license or activation code issued by the tutor service. No master key is built into the addon.">
                            <field name="chatbot_activation_code" password="True" groups="base.group_system" />
                            <button name="action_activate_tutor" type="object" string="Activate service" class="btn-primary" groups="base.group_system" />
                        </setting>
                    </block>
                    <block title="LLM Configuration" name="odoo_tutor_llm_settings">
                        <setting string="Provider" help="Choose the language model provider.">
                            <field name="chatbot_llm_provider" groups="base.group_system" />
                        </setting>
                        <setting string="LLM API Key" help="Enter the API key for your selected language model provider.">
                            <field name="chatbot_llm_api_key" password="True" groups="base.group_system" />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
