<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_odoo_tutor" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.odoo.tutor</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Odoo AI Tutor" string="Odoo AI Tutor" name="odoo_tutor">
                    <block title="Proveedor de IA personal" name="odoo_tutor_llm_settings">
                        <setting string="Proveedor" help="La selección y las credenciales se guardan para el usuario actual.">
                            <field name="odoo_tutor_llm_provider"/>
                        </setting>
                        <setting string="Modelo" help="Opcional; deja vacío para usar el modelo predeterminado del proveedor.">
                            <field name="odoo_tutor_llm_model" placeholder="Predeterminado"/>
                        </setting>
                        <setting string="API key" help="Clave personal del proveedor. Se envía directamente de Odoo al backend en un ticket de un solo uso.">
                            <field name="odoo_tutor_llm_api_key" password="True" placeholder="Pega la clave del proveedor"/>
                        </setting>
                        <setting string="AWS secret key" help="Solo para credenciales AWS personales de Bedrock. Si se deja vacío, el backend usa su rol o perfil de servidor.">
                            <field name="odoo_tutor_llm_api_secret" password="True"/>
                        </setting>
                        <setting string="AWS region" help="Región de Amazon Bedrock cuando el proveedor seleccionado es Bedrock.">
                            <field name="odoo_tutor_llm_region" placeholder="eu-north-1"/>
                        </setting>
                    </block>
                    <block title="Servidor del tutor" name="odoo_tutor_setting_container">
                        <setting string="Servidor Backend" help="URL interna del backend del tutor. La clave de acceso al backend la configura el administrador.">
                            <field name="odoo_tutor_backend_url" placeholder="https://api.tudominio.com"/>
                        </setting>
                    </block>
                    <block title="Conexión WebSocket (Opcional)" name="odoo_tutor_ws_container">
                        <setting string="WebSocket URL" help="URL del servidor WebSocket para sesiones interactivas.">
                            <field name="chatbot_ws_base_url" placeholder="wss://tutor-backend.odooconcept.com/ws"/>
                        </setting>
                        <setting string="API Key WebSocket" help="Clave de autenticación para el servidor WebSocket.">
                            <field name="chatbot_api_key" password="True"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
