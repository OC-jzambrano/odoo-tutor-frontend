<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_odoo_tutor" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.chatbot</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Odoo Tutor" name="odoo_tutor">
                    <block title="Tutor Service" name="odoo_tutor_chatbot_settings">
                        <setting string="WebSocket URL" help="WebSocket address of the tutor service for interactive sessions.">
                            <field
                                name="chatbot_ws_base_url"
                                placeholder="wss://tutor-backend.odooconcept.com/ws"
                            />
                        </setting>
                        <setting string="Tutor Service API Key" help="Authentication key used to connect to the tutor service.">
                            <field name="chatbot_api_key" password="True" />
                        </setting>
                    </block>
                    <block title="LLM Configuration" name="odoo_tutor_llm_settings">
                        <setting string="Provider" help="Choose the language model provider.">
                            <select class="form-select" aria-label="LLM provider">
                                <option value="openai" selected="selected">OpenAI</option>
                                <option value="anthropic">Claude (Anthropic)</option>
                                <option value="google">Gemini (Google)</option>
                                <option value="other">Other provider</option>
                            </select>
                        </setting>
                        <setting string="LLM API Key" help="Enter the API key for your selected language model provider.">
                            <input
                                type="password"
                                class="form-control"
                                autocomplete="off"
                                placeholder="Enter your provider API key"
                                aria-label="LLM API key"
                            />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
