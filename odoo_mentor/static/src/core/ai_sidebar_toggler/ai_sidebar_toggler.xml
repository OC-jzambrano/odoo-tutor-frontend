<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="ai_chat.AiFloatingButton">
        <t t-if="this.state.showButton">
            <div
                class="ai-floating-button o-overlay-item"
                data-ai-tutor-ignore-event="true"
                t-ref="this.floatingRoot"
                t-att-class="{
                    'is-dragging': this.state.dragging,
                    'is-open': this.state.chatOpen,
                    'is-recording': this.state.recorderStatus === 'recording',
                    'is-recording-paused': this.state.recorderStatus === 'paused',
                    'has-preview': (this.dryRunBubbleVisible || (this.state.previewVisible &amp;&amp; this.state.previewMessage)) &amp;&amp; !this.state.chatOpen &amp;&amp; !this.state.dragging,
                    'has-exercise-cta': this.launcherExerciseCtaVisible,
                    'has-attention': this.launcherHasAttention,
                    'is-fresh': this.isPreviewFresh,
                }"
                t-att-style="
                    'transform: translate3d(' + this.state.dragX + 'px, ' + this.state.dragY + 'px, 0);' +
                    (this.state.chatOpen ? ' opacity:0; pointer-events:none;' : '')
                "
            >
                <t t-if="this.dryRunBubbleVisible">
                    <div class="ai-owl-preview ai-owl-dry-run-bubble"
                         data-ai-tutor-ignore-event="true"
                         t-on-mousedown.stop="this.noop"
                         t-on-touchstart.stop="this.noop"
                         t-on-click.stop="this.noop">
                        <button
                            type="button"
                            class="ai-owl-preview-close"
                            t-on-mousedown.stop.prevent="this.noop"
                            t-on-touchstart.stop.prevent="this.noop"
                            t-on-click.stop.prevent="this.onDryRunStop"
                            t-att-title="this.translate('Stop Dry-Run')"
                            t-att-aria-label="this.translate('Stop Dry-Run')"
                        >×</button>

                        <div class="ai-owl-dry-run-header">
                            <span class="ai-owl-dry-run-badge">
                                <t t-out="this.translate('Dry-Run')"/>
                                <t t-out="' · ' + (this.state.dryRun.stepIndex + 1) + '/' + this.state.dryRun.totalSteps"/>
                            </span>
                            <span t-if="this.state.dryRun.step.is_optional" class="ai-owl-dry-run-opt-tag">
                                <t t-if="this.state.dryRun.blockRange and this.state.dryRun.blockRange.count >= 2"
                                   t-out="this.translate('Optional block') + ' (' + this.state.dryRun.blockRange.count + ')'"/>
                                <t t-else="" t-out="this.translate('Optional')"/>
                            </span>
                        </div>

                        <div class="ai-owl-preview-text ai-owl-dry-run-instruction"
                             t-out="this.state.dryRun.step.instruction"/>

                        <div class="ai-owl-dry-run-actions" role="group" t-att-aria-label="this.translate('Dry-Run actions')">
                            <button
                                type="button"
                                class="ai-owl-dry-run-btn"
                                t-on-mousedown.stop.prevent="this.noop"
                                t-on-touchstart.stop.prevent="this.noop"
                                t-on-click.stop.prevent="this.onDryRunLocate"
                                t-att-title="this.translate('Locate element on this screen')"
                            >
                                <i class="oi" data-icon="my_location"/>
                                <t t-out="this.translate('Locate')"/>
                            </button>

                            <button
                                type="button"
                                class="ai-owl-dry-run-btn ai-owl-dry-run-btn-edit"
                                t-on-mousedown.stop.prevent="this.noop"
                                t-on-touchstart.stop.prevent="this.noop"
                                t-on-click.stop.prevent="this.onDryRunEdit"
                                t-att-title="this.translate('Pause and edit this step in the sidebar')"
                            >
                                <i class="oi" data-icon="edit"/>
                                <t t-out="this.translate('Edit')"/>
                            </button>

                            <button
                                type="button"
                                class="ai-owl-dry-run-btn"
                                t-on-mousedown.stop.prevent="this.noop"
                                t-on-touchstart.stop.prevent="this.noop"
                                t-on-click.stop.prevent="this.onDryRunSkip"
                                t-att-title="this.translate('Skip to next step')"
                            >
                                <i class="oi" data-icon="skip_next"/>
                                <t t-out="this.translate('Skip')"/>
                            </button>

                            <button
                                type="button"
                                class="ai-owl-dry-run-btn ai-owl-dry-run-btn-delete"
                                t-on-mousedown.stop.prevent="this.noop"
                                t-on-touchstart.stop.prevent="this.noop"
                                t-on-click.stop.prevent="this.onDryRunDelete"
                                t-att-title="this.translate('Delete this step and continue Dry-Run')"
                                t-att-aria-label="this.translate('Delete step')"
                            >
                                <i class="oi" data-icon="delete"/>
                                <t t-out="this.translate('Delete')"/>
                            </button>

                            <button
                                type="button"
                                class="ai-owl-dry-run-opt-pill"
                                t-att-class="{ 'is-active': this.state.dryRun.step.is_optional }"
                                t-on-mousedown.stop.prevent="this.noop"
                                t-on-touchstart.stop.prevent="this.noop"
                                t-on-click.stop.prevent="this.onDryRunToggleOptional"
                                t-att-title="this.translate('Toggle optional')"
                            >
                                <t t-out="this.translate('Optional')"/>
                            </button>
                        </div>

                        <div t-if="this.state.dryRun.skippedPromptStepId" class="ai-owl-dry-run-skip-prompt">
                            <span>
                                <t t-out="this.translate('Skipped Step')"/>
                                <t t-out="' ' + this.state.dryRun.skippedPromptStepNumber + ' — '"/>
                                <t t-out="this.translate('Mark as optional?')"/>
                            </span>
                            <div class="ai-owl-dry-run-skip-prompt-actions">
                                <button
                                    type="button"
                                    class="ai-owl-dry-run-skip-confirm"
                                    t-on-mousedown.stop.prevent="this.noop"
                                    t-on-touchstart.stop.prevent="this.noop"
                                    t-on-click.stop.prevent="this.onDryRunMarkSkippedOptional"
                                >
                                    <t t-out="this.translate('Mark optional')"/>
                                </button>
                                <button
                                    type="button"
                                    class="ai-owl-dry-run-skip-dismiss"
                                    t-on-mousedown.stop.prevent="this.noop"
                                    t-on-touchstart.stop.prevent="this.noop"
                                    t-on-click.stop.prevent="this.onDryRunDismissSkippedPrompt"
                                    t-att-aria-label="this.translate('Dismiss')"
                                >×</button>
                            </div>
                        </div>

                        <div class="ai-owl-preview-tail"/>
                    </div>
                </t>
                <t t-elif="this.state.previewVisible and this.state.previewMessage and !this.state.chatOpen and !this.state.dragging">
                    <div class="ai-owl-preview"
                         role="button"
                         tabindex="0"
                         data-ai-tutor-ignore-event="true"
                         t-on-click.stop.prevent="this.toggleChat"
                         t-on-mouseenter="this.pausePreview"
                         t-on-mouseleave="this.resumePreview">
                        <button
                            type="button"
                            class="ai-owl-preview-close"
                            t-on-mousedown.stop.prevent="this.noop"
                            t-on-touchstart.stop.prevent="this.noop"
                            t-on-click.stop.prevent="this.closePreview"
                            t-att-aria-label="this.translate('Close preview')"
                        >×</button>
                        <div class="ai-owl-preview-time">
                            <t t-out="this.previewTimeAgo"/>
                        </div>

                        <div class="ai-owl-preview-text">
                            <t t-foreach="this.previewSegments" t-as="seg" t-key="seg_index">
                                <t t-if="seg.isCopy">
                                    <span
                                        class="ai-copy-value"
                                        t-att-class="{ 'is-copied': this.state.previewCopiedText === seg.text }"
                                        t-att-data-copy-text="seg.text"
                                        role="button"
                                        tabindex="0"
                                        t-att-title="this.state.previewCopiedText === seg.text ? this.translate('Copied!') : seg.copyLabel"
                                        t-att-aria-label="seg.copyLabel"
                                        t-on-click="(ev) => this.onCopyPreviewSegment(seg, ev)"
                                        t-on-mousedown.stop.prevent="this.noop"
                                        t-on-touchstart.stop.prevent="this.noop"
                                        t-out="seg.text"
                                    />
                                </t>
                                <t t-elif="seg.isBold">
                                    <strong t-out="seg.text"/>
                                </t>
                                <t t-else="">
                                    <t t-out="seg.text"/>
                                </t>
                            </t>
                        </div>

                        <t t-if="this.state.previewQuotaCtaVisible">
                            <div class="ai-owl-quota-actions"
                                 role="group"
                                 t-att-aria-label="this.translate('Subscription actions')">
                                <a
                                    class="ai-owl-quota-plan-btn"
                                    t-att-href="this.tutorPlansUrl"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    t-on-mousedown.stop.prevent="this.noop"
                                    t-on-touchstart.stop.prevent="this.noop"
                                    t-on-click.stop.prevent="this.onQuotaPlanClick"
                                >
                                    <t t-out="this.translate('Get a subscription')"/>
                                </a>
                            </div>
                        </t>

                        <t t-if="this.launcherExerciseCtaVisible">
                            <div class="ai-owl-exercise-actions"
                                 role="group"
                                 t-att-aria-label="this.translate('Exercise invitation actions')">
                                <button
                                    type="button"
                                    class="ai-owl-exercise-choice ai-owl-exercise-choice-yes"
                                    t-att-disabled="this.exerciseCtaBusy"
                                    t-on-mousedown.stop.prevent="this.noop"
                                    t-on-touchstart.stop.prevent="this.noop"
                                    t-on-click.stop.prevent="this.onExerciseCtaStart"
                                >
                                    <i t-if="this.exerciseCtaBusy" class="oi tutor-oi-spinner" data-icon="refresh"/>
                                    <i t-else="" class="oi" data-icon="check"/>
                                    <t t-if="this.exerciseCtaBusy" t-out="this.translate('Starting...')"/>
                                    <t t-else="" t-out="this.translate('Yes')"/>
                                </button>

                                <button
                                    type="button"
                                    class="ai-owl-exercise-choice ai-owl-exercise-choice-cancel"
                                    t-att-disabled="this.exerciseCtaBusy"
                                    t-on-mousedown.stop.prevent="this.noop"
                                    t-on-touchstart.stop.prevent="this.noop"
                                    t-on-click.stop.prevent="this.onExerciseCtaCancel"
                                >
                                    <i class="oi" data-icon="close"/>
                                    <t t-out="this.translate('Cancel')"/>
                                </button>
                            </div>
                        </t>

                        <div class="ai-owl-preview-tail"/>
                    </div>
                </t>

                <button
                    class="ai-owl-trigger"
                    type="button"
                    t-on-mousedown.stop.prevent="this.onIconDragStart"
                    t-on-touchstart.stop.prevent="this.onIconDragStart"
                    t-on-click="this.onIconClick"
                    data-ai-sidebar-toggle="1"
                    aria-controls="offcanvasAiSidebar"
                    t-att-aria-label="this.openTutorLabel"
                    t-att-title="this.openTutorTitle"
                >
                    <span class="ai-owl-trigger-halo"/>
                    <span class="ai-owl-trigger-shell">
                        <span class="ai-owl-trigger-core">
                            <img
                                t-att-src="'/odoo_mentor/static/images/iabotv2.png'"
                                alt="Asistente IA"
                                class="ai-owl-trigger-img"
                            />
                        </span>
                    </span>

                    <span class="ai-owl-trigger-badge">
                        <span t-if="this.state.recorderStatus === 'recording'"
                              class="ai-owl-trigger-rec-dot"
                              aria-hidden="true"/>
                        <span t-elif="this.state.recorderStatus === 'paused'"
                              class="ai-owl-trigger-rec-pause"
                              aria-hidden="true">
                            <span/>
                            <span/>
                        </span>
                        <t t-else="">AI</t>
                    </span>
                    <span t-if="!this.state.optionalStepVisible and this.state.hintBadgeVisible" class="ai-owl-trigger-hint" title="Nueva pista">
                        <i class="oi" data-icon="lightbulb"/>
                    </span>
                </button>
                <button
                    t-if="this.state.optionalStepVisible"
                    type="button"
                    class="ai-owl-trigger-skip"
                    t-att-disabled="this.state.optionalStepLoading"
                    t-att-title="this.translate('Skip optional step')"
                    t-att-aria-label="this.translate('Skip optional step')"
                    t-on-mousedown.stop.prevent="this.noop"
                    t-on-touchstart.stop.prevent="this.noop"
                    t-on-click.stop.prevent="this.onSkipOptionalStep"
                >
                    <i t-att-class="this.state.optionalStepLoading ? 'oi tutor-oi-spinner' : 'oi'" t-att-data-icon="this.state.optionalStepLoading ? 'refresh' : 'skip_next'"/>
                </button>
            </div>
        </t>
    </t>
</templates>
