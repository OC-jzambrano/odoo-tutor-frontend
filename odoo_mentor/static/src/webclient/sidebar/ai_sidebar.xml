<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="ai_chat.AiSidebar">
        <div
            class="offcanvas offcanvas-end d-flex flex-column"
            t-att-class="{
                'is-dark-theme': this.state.colorScheme === 'dark',
                'is-light-theme': this.state.colorScheme !== 'dark',
            }"
            tabindex="-1"
            id="offcanvasAiSidebar"
            aria-labelledby="offcanvasAiSidebarLabel"
            t-attf-style="width: {{ this.state.width }};"
            t-ref="this.containerRef"
        >
            <div
                class="handle ai-sidebar-handle"
                t-ref="this.handleRef"
                t-on-mousedown="this.onHandleMouseDown"
            />

            <div class="offcanvas-header ai-sidebar-header">
                <div class="ai-sidebar-header-main">
                    <div class="ai-sidebar-brand">
                        <span class="ai-sidebar-brand-mark">
                            <i class="oi" t-att-data-icon="this.state.showRecorderPanel ? 'radio_button_checked' : 'chat_bubble'"/>
                        </span>

                        <div class="ai-sidebar-brand-copy">
                            <h5 class="offcanvas-title" id="offcanvasExampleLabel">Odoo Tutor</h5>
                            <div class="ai-sidebar-subtitle">
                                <t t-if="this.state.showRecorderPanel" t-out="this.translate('Recorder workspace for guided flows')"/>
                                <t t-else="" t-out="this.currentRouteLabel"/>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="ai-sidebar-header-actions">
                    <button
                        t-if="this.state.canSeeRecorderToggle"
                        type="button"
                        class="btn ai-sidebar-recorder-toggle"
                        t-on-click.stop.prevent="this.toggleRecorderPanel"
                    >
                        <t t-if="this.state.showRecorderPanel" t-out="this.translate('Back to chat')"/>
                        <t t-else="" t-out="this.translate('Record an exercise')"/>
                    </button>
                    <button
                        t-if="!this.state.showRecorderPanel"
                        type="button"
                        class="btn rounded-circle p-1 btn-refresh ai-sidebar-reset"
                        t-att-aria-label="this.translate('Reset')"
                        t-on-click.stop.prevent="this.reset"
                    >
                        <i class="oi" data-icon="refresh"/>
                    </button>

                    <div t-if="this.state.processActive and !this.state.showRecorderPanel" class="d-flex align-items-center">
                        <button
                            type="button"
                            class="timer-display"
                            t-att-title="this.translate('Cancel exercise')"
                            t-att-aria-label="this.translate('Cancel exercise')"
                            t-att-disabled="this.state.exerciseCancelLoading"
                            t-on-click.stop.prevent="this.onTimerCancelExercise"
                        >
                            <t t-out="this.state.timerValue" t-if="this.state.timerValue"/>
                            <t t-else="">00:00:00</t>
                            <i t-if="this.state.exerciseCancelLoading" class="oi tutor-oi-spinner timer-cancel-icon" data-icon="refresh"/>
                            <i t-else="" class="oi timer-cancel-icon" data-icon="close"/>
                        </button>
                    </div>

                    <button
                        type="button"
                        class="btn ai-sidebar-close text-reset"
                        t-att-aria-label="this.translate('Close')"
                        t-on-click.stop.prevent="this.onCloseSidebar"
                    ><i class="oi" data-icon="close"/></button>
                </div>
            </div>

            <div class="offcanvas-body ai-sidebar-body flex-grow-1 d-flex flex-column">
                <div class="ai-sidebar-content flex-grow-1 d-flex flex-column h-100">

                    <!-- Keep the recorder panel mounted and hide it when inactive. -->
                    <div t-att-class="this.state.showRecorderPanel ? 'flex-grow-1 d-flex flex-column h-100' : 'd-none'">
                        <div class="o_ai_recorder_panel" t-att-class="this.state.recorderStatus === 'recording' ? 'is-recording' : ''">
                            <div class="o_ai_recorder_header">
                                <div class="o_ai_recorder_left">
                                    <span t-if="this.state.recorderStatus === 'recording'" class="o_ai_rec_badge">
                                        <i class="oi oi-filled" data-icon="circle"/>
                                        <t t-out="this.translate('Recording')"/>
                                    </span>
                                    <span t-elif="this.state.recorderStatus === 'paused'" class="badge text-bg-warning">
                                        <t t-out="this.translate('Paused')"/>
                                    </span>
                                    <span class="o_ai_rec_title" t-out="this.translate('Recorder')"/>
                                </div>

                                <div class="o_ai_recorder_right">
                                    <t t-if="this.state.canReviewRecordings">
                                        <button type="button"
                                                class="btn btn-sm"
                                                t-att-class="!this.state.recorderReviewTab ? 'btn-dark' : 'btn-outline-secondary'"
                                                t-on-click.stop.prevent="() => this.toggleRecorderReviewTab(false)">
                                            <t t-out="this.translate('Record')"/>
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm"
                                                t-att-class="this.state.recorderReviewTab ? 'btn-dark' : 'btn-outline-secondary'"
                                                t-on-click.stop.prevent="() => this.toggleRecorderReviewTab(true)">
                                            <t t-out="this.translate('Review')"/>
                                        </button>
                                    </t>

                                    <t t-if="!this.state.recorderReviewTab">
                                        <button t-if="this.state.recorderStatus !== 'recording'"
                                                type="button"
                                                class="btn btn-sm btn-primary"
                                                t-att-disabled="this.state.recorderStatus === 'idle' and (!(this.state.recorderTitle || '').trim() or !(this.state.recorderModule || '').trim())"
                                                t-on-click.stop.prevent="this.onRecorderStart">
                                            <i class="oi" data-icon="play_arrow"/>
                                            <t t-if="this.state.recorderStatus === 'paused'" t-out="this.translate('Resume')"/>
                                            <t t-else="" t-out="this.translate('Start')"/>
                                        </button>

                                        <button t-if="this.state.recorderStatus === 'recording'"
                                                type="button"
                                                class="btn btn-sm btn-secondary"
                                                t-on-click.stop.prevent="this.onRecorderPause">
                                            <i class="oi" data-icon="pause"/> <t t-out="this.translate('Pause')"/>
                                        </button>

                                        <button t-if="this.state.recorderStatus !== 'idle'"
                                                type="button"
                                                class="btn btn-sm btn-danger"
                                                t-on-click.stop.prevent="this.onRecorderFinish">
                                            <i class="oi" data-icon="stop"/> <t t-out="this.translate('Discard')"/>
                                        </button>
                                    </t>
                                </div>
                            </div>

                            <t t-if="this.state.recorderReviewTab and this.state.canReviewRecordings">
                                <div class="d-flex flex-column gap-2 p-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <strong t-out="this.translate('Pending Drafts')"/>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                t-att-disabled="this.state.reviewLoading"
                                                t-on-click.stop.prevent="this.loadReviewQueue">
                                            <t t-out="this.translate('Refresh')"/>
                                        </button>
                                    </div>

                                    <div t-if="!this.state.reviewQueue.length" class="text-muted small">
                                        <t t-out="this.translate('No pending recordings in this tenant.')"/>
                                    </div>

                                    <div class="d-flex flex-column gap-1" t-if="this.state.reviewQueue.length">
                                        <t t-foreach="this.state.reviewQueue" t-as="item" t-key="item.recording_id + '_' + item.author_id">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary text-start d-flex justify-content-between align-items-center"
                                                    t-on-click.stop.prevent="() => this.inspectReviewDraft(item.recording_id, item.author_id)">
                                                <span>
                                                    <strong t-out="item.title"/> (<span t-out="item.module"/>)
                                                </span>
                                                <span class="badge text-bg-light" t-out="item.step_count + ' steps'"/>
                                            </button>
                                        </t>
                                    </div>

                                    <div t-if="this.state.reviewDetail" class="border rounded p-2 d-flex flex-column gap-2 mt-2">
                                        <div>
                                            <div class="fw-bold" t-out="this.state.reviewDetail.draft.title"/>
                                            <div class="small text-muted">
                                                <t t-out="this.state.reviewDetail.draft.module"/> ·
                                                <t t-out="this.state.reviewDetail.review_status"/>
                                            </div>
                                        </div>
                                        <ol class="ps-3 mb-1 small">
                                            <t t-foreach="this.state.reviewDetail.draft.steps" t-as="rstep" t-key="rstep.id">
                                                <li t-out="rstep.instruction"/>
                                            </t>
                                        </ol>
                                        <input type="text"
                                               class="form-control form-control-sm"
                                               t-att-value="this.state.reviewComment"
                                               t-on-input="(ev) => this.state.reviewComment = ev.target.value"
                                               t-att-placeholder="this.translate('Review comment (optional)...')"/>
                                        <div class="d-flex gap-2">
                                            <button type="button"
                                                    class="btn btn-sm btn-success"
                                                    t-att-disabled="this.state.reviewLoading"
                                                    t-on-click.stop.prevent="() => this.submitReviewDecision('approved')">
                                                <t t-out="this.translate('Approve')"/>
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    t-att-disabled="this.state.reviewLoading"
                                                    t-on-click.stop.prevent="() => this.submitReviewDecision('rejected')">
                                                <t t-out="this.translate('Reject')"/>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </t>

                            <t t-else="">
                                <div class="o_ai_recorder_meta d-flex flex-column gap-2">
                                    <div>
                                        <label class="form-label small mb-1" t-out="this.translate('Exercise title')"/>
                                        <input type="text"
                                               class="form-control form-control-sm"
                                               t-att-disabled="this.state.recorderStatus !== 'idle'"
                                               t-att-value="this.state.recorderTitle"
                                               t-on-input="(ev) => this.state.recorderTitle = ev.target.value"
                                               t-att-placeholder="this.translate('e.g. Create a sales quotation')"/>
                                    </div>
                                    <div>
                                        <label class="form-label small mb-1" t-out="this.translate('Odoo app / module')"/>
                                        <input type="text"
                                               class="form-control form-control-sm"
                                               t-att-disabled="this.state.recorderStatus !== 'idle'"
                                               t-att-value="this.state.recorderModule"
                                               t-on-input="(ev) => this.state.recorderModule = ev.target.value"
                                               t-att-placeholder="this.translate('e.g. sale, crm, stock')"/>
                                    </div>
                                    <div class="o_ai_rec_meta_row">
                                        <span class="lbl" t-out="this.translate('Session ID:')"/>
                                        <span class="val" t-out="this.state.recorderSessionId || '-'"/>
                                    </div>
                                </div>

                                <div class="o_ai_recorder_controls">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            t-att-disabled="this.state.recorderStatus === 'idle' or this.state.recorderPicking"
                                            t-on-click.stop.prevent="this.onRecorderPick">
                                        <t t-if="this.state.recorderPicking">
                                            <i class="oi tutor-oi-spinner" data-icon="my_location"/> <t t-out="this.translate('Picking...')"/>
                                        </t>
                                        <t t-else="">
                                            <i class="oi" data-icon="my_location"/> <t t-out="this.translate('Pick element')"/>
                                        </t>
                                    </button>

                                    <button t-if="this.state.recorderPicked"
                                            type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            t-on-click.stop.prevent="this.onRecorderClearPick">
                                        <i class="oi" data-icon="close"/> <t t-out="this.translate('Clear')"/>
                                    </button>

                                    <div class="o_ai_recorder_pick" t-if="this.state.recorderPicked">
                                        <i class="oi" data-icon="adjust"/>
                                        <span t-out="this.state.recorderPicked.target_key"/>
                                    </div>
                                </div>

                                <div class="o_ai_recorder_step" t-if="this.state.recorderPicked or (this.state.recorderNote || '').trim()">
                                    <textarea class="form-control"
                                              rows="2"
                                              t-att-value="this.state.recorderNote" t-on-input="(ev) => this.state.recorderNote = ev.target.value"
                                              t-att-placeholder="this.translate('Step instruction (optional)...')"></textarea>

                                    <div class="o_ai_rec_step_actions">
                                        <button type="button"
                                                class="btn btn-sm btn-success"
                                                t-att-disabled="this.state.recorderStatus === 'idle'"
                                                t-on-click.stop.prevent="this.onRecorderSaveStep">
                                            <i class="oi" data-icon="save"/> <t t-out="this.translate('Add step')"/>
                                        </button>
                                    </div>
                                </div>

                                <div class="o_ai_recorder_feed">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <div class="o_ai_rec_feed_title" t-out="this.translate('Generated steps')"/>
                                        <button type="button"
                                                class="btn btn-sm btn-success"
                                                t-att-disabled="this.state.recorderSaving or !(this.state.recorderSteps || []).length"
                                                t-on-click.stop.prevent="this.onRecorderSaveForReview">
                                            <i class="oi" data-icon="save"/> <t t-out="this.translate('Save for later review')"/>
                                        </button>
                                    </div>

                                    <div class="o_ai_rec_feed_list">
                                        <div t-if="!(this.state.recorderSteps || []).length" class="text-muted small">
                                            <t t-out="this.translate('Start capture and interact with Odoo to generate editable steps.')"/>
                                        </div>
                                        <t t-foreach="this.state.recorderSteps" t-as="step" t-key="step.id">
                                            <div class="o_ai_rec_feed_item d-flex flex-column gap-1">
                                                <div class="d-flex gap-1 align-items-center">
                                                    <input type="text"
                                                           class="form-control form-control-sm"
                                                           t-att-value="step.instruction"
                                                           t-on-input="(ev) => this.onRecorderUpdateStepInstruction(step.id, ev.target.value)"/>
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-danger"
                                                            t-att-aria-label="this.translate('Remove step')"
                                                            t-on-click.stop.prevent="() => this.onRecorderRemoveStep(step.id)">
                                                        <i class="oi" data-icon="close"/>
                                                    </button>
                                                </div>
                                                <div class="line2 small text-muted">
                                                    <span t-out="step.target.action"/> · <span t-out="step.target.target_key || step.target.field || '-'"/>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>

                    <!-- Keep the chat panel mounted and hide it when inactive. -->
                    <div t-att-class="this.state.showRecorderPanel ? 'd-none' : {
                        'ai-chat-panel flex-grow-1 d-flex flex-column h-100 position-relative': true,
                        'has-skip-step': this.state.skipStepEnabled and this.state.processActive,
                    }"
                         t-ref="this.chatPanelRef">
                        <!-- Keep this as a normal element so libraries can mount into it. -->
                        <div t-ref="this.chatUiRef"
                             id="chat-ui-container"
                             t-att-class="{
                                 'h-100': true,
                             }"
                             t-att-aria-busy="this.state.isLoading ? 'true' : 'false'"></div>

                        <button
                            t-if="this.state.skipStepEnabled and this.state.processActive"
                            type="button"
                            class="ai-skip-step-button"
                            data-ai-tutor-ignore-event="true"
                            t-att-disabled="this.state.skipStepLoading"
                            t-att-title="this.translate('Skip to next step')"
                            t-att-aria-label="this.translate('Skip to next step')"
                            t-on-click.stop.prevent="this.onSkipStep"
                        >
                            <i t-att-class="this.state.skipStepLoading ? 'oi tutor-oi-spinner' : 'oi'" t-att-data-icon="this.state.skipStepLoading ? 'refresh' : 'skip_next'"/>
                        </button>

                        <button t-if="showUnreadIndicator"
                                type="button"
                                class="ai-new-message-indicator"
                                t-attf-style="bottom: {{ this.state.composerHeight + 16 }}px;"
                                t-on-click.stop.prevent="this.jumpToNewestMessage"
                                t-att-aria-label="this.unreadIndicatorLabel">
                            <span class="ai-new-message-dot"/>
                            <span class="ai-new-message-label" t-out="this.unreadIndicatorLabel"/>
                        </button>

                        <t t-if="this.state.hintVisible and this.state.hintMessage">
                            <div t-att-class="{
                                     'ai-inline-hint-container': true,
                                     'ai-inline-hint-container-raised': this.state.skipStepEnabled and this.state.processActive,
                                 }"
                                 t-attf-style="bottom: {{ this.state.composerTopOffset + ((this.state.skipStepEnabled and this.state.processActive) ? 58 : 8) }}px;"
                                 t-ref="this.inlineHintRef">
                                <div class="ai-inline-hint"
                                     t-key="this.state.hintCycle"
                                     t-att-class="{
                                         'is-exiting': this.state.hintExiting,
                                         'is-paused': this.state.hintHovered,
                                     }"
                                     t-on-mouseenter="this.pauseInlineHint"
                                     t-on-mouseleave="this.resumeInlineHint">
                                    <div class="ai-inline-hint-header">
                                        <div class="ai-inline-hint-badge">
                                            <span class="ai-inline-hint-badge-icon">
                                                <i class="oi" data-icon="lightbulb"/>
                                            </span>
                                            <span class="ai-inline-hint-badge-text" t-out="this.translate('Context hint')"/>
                                        </div>

                                        <div class="ai-inline-hint-time">
                                            <t t-out="this.hintTimeAgo"/>
                                        </div>
                                    </div>

                                    <button
                                        type="button"
                                        class="ai-inline-hint-close"
                                        t-on-click.stop.prevent="this.closeInlineHint"
                                        t-att-aria-label="this.translate('Close hint')"
                                    >×</button>

                                    <div class="ai-inline-hint-text">
                                        <t t-out="this.state.hintMessage"/>
                                    </div>
                                </div>
                            </div>
                        </t>

                        <div class="ai-buttons-container"
                             t-att-class="{'visible': this.state.showButtons and this.state.processActive}"
                             t-attf-style="bottom: {{ this.state.composerHeight + 25 }}px;">

                            <div t-if="this.state.processActive" class="d-flex align-items-center">
                                <button
                                    class="dk-btn dk-btn-secondary me-2"
                                    t-att-title="this.translate('Cancel')"
                                    t-att-aria-label="this.translate('Cancel')"
                                    t-on-click.stop.prevent="this.cancelProcess">
                                    <i class="oi" data-icon="close"/>
                                </button>

                                <button class="dk-btn dk-btn-accent"
                                        t-att-title="this.translate('Finish')"
                                        t-att-aria-label="this.translate('Finish')"
                                        t-on-click.stop.prevent="this.showResultModal"
                                        t-att-disabled="this.state.finishLoading">
                                    <t t-if="this.state.finishLoading">
                                        <i class="oi tutor-oi-spinner" data-icon="refresh"/>
                                    </t>
                                    <i t-else="" class="oi" data-icon="check"/>
                                </button>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </t>
</templates>
