<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="group_odoo_tutor_expert" model="res.groups">
        <field name="name">Odoo Tutor Expert</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_odoo_tutor_reviewer" model="res.groups">
        <field name="name">Odoo Tutor Reviewer</field>
        <field name="implied_ids" eval="[(4, ref('odoo_mentor.group_odoo_tutor_expert'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('odoo_mentor.group_odoo_tutor_reviewer'))]"/>
    </record>
</odoo>
